# NurStuHelp environment configuration
#
# Copy to `.env.local` (gitignored) and fill in.
#
# When BOTH variables are set, the app uses SupabaseCardRepository
# (read-only, with IndexedDB offline cache). When unset, the app
# falls back to LocalCardRepository (compiled-in seed bundle).

# Required — Supabase project URL (e.g. https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# Required — Supabase anon public key. Safe to ship in client; protected by RLS.
# NEVER put the service_role key here — that bypasses RLS.
VITE_SUPABASE_ANON_KEY=
